# --- Modo demo solo Vercel (sin gateway Fly/Docker) ---
# En Vercel: Project Settings → Environment Variables
NEXT_PUBLIC_BALLOT_MODE=vercel

# --- Modo completo (frontend + gateway externo) ---
# NEXT_PUBLIC_BALLOT_MODE=gateway
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# Opcional en el servidor: expone /api/demo aunque el cliente no declare modo vercel
# BALLOT_VERCEL_DEMO=1
