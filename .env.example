# El front elige con una sola variable.
# Sin ella simula el preconteo en este proceso (memoria, o Upstash si están las dos de abajo).
# Con ella usa WebSocket y SSE del gateway. No hace falta otra bandera.

# Stack local: nginx en :8080, o un solo gateway en :4000.
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# Deploy en Vercel, para que todas las visitas vean el mismo preconteo simulado.
# Storage → Upstash Redis inyecta estas dos. Sin ellas cada función tiene su memoria.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
